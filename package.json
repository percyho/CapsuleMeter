{
  "name": "capsule-meter",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:macos": "tauri build --bundles app --target universal-apple-darwin",
    "build:macos:arm64": "tauri build --bundles app --target aarch64-apple-darwin",
    "build:patch": "node scripts/bump-version.js patch && tauri build",
    "build:minor": "node scripts/bump-version.js minor && tauri build",
    "build:major": "node scripts/bump-version.js major && tauri build"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/oxanium": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "echarts": "^6.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
